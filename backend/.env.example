# Copy to .env and adjust. Never commit .env.

# LAN example. Use 0.0.0.0:8080 to listen on every interface, or a specific NIC:
# SEYRA_HTTP_ADDR=172.20.1.78:8080
# Flutter web LAN origin for CORS (http://172.20.1.78:5000)
# SEYRA_CORS_ORIGINS=http://172.20.1.78:5000
SEYRA_HTTP_ADDR=:8080
# Docker Compose uses 5432. If a different Postgres already owns that port, use 5433.
SEYRA_DATABASE_URL=postgres://seyra:seyra@127.0.0.1:5432/seyra?sslmode=disable
# High-entropy value used to HMAC session tokens at rest. Change in every environment.
SEYRA_SESSION_PEPPER=replace-with-a-long-random-dev-string
# Optional push gateway (FCM/APNs adapter). Leave empty in local development.
# SEYRA_PUSH_WEBHOOK_URL=
# Optional STUN/TURN. Do not commit production TURN credentials.
# SEYRA_STUN_URLS=stun:stun.l.google.com:19302
# SEYRA_TURN_URL=
# SEYRA_TURN_USERNAME=
# SEYRA_TURN_CREDENTIAL=
# Production TLS (required when SEYRA_ENV=production)
# SEYRA_ENV=development
# SEYRA_TLS_CERT=
# SEYRA_TLS_KEY=
